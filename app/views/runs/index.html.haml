.container
  .well
    %h1 Runs Selection
    %hr/
    %h4 Search Options
    = search_form_for @q do |f|
      .row
        .col-md-12
          .form-group.chardin_box
            = f.label :name
            = f.search_field :name_cont
            = f.label :note_cont
            = f.search_field :note_cont
            = f.label "Run on"
            = f.text_field :start_gteq, class: 'datepicker'
      .row
        .col-md-12
          .form-group.chardin_box
            = f.label :status
            = f.select :status_eq, Run.order(:status).uniq.pluck(:status), include_blank: true
            = f.label :error
            = f.check_box :with_error
            = f.label :done
            = f.check_box :with_done
            = f.label :never_viewed
            = f.check_box :with_nv
          .form-group.chardin_box
            = f.submit class: 'btn btn-info btn-xs'
            = link_to 'Clear Filters', runs_path, class: 'btn btn-default btn-xs'
  %br/
  #results
    = render :partial => 'runs/list', locals: { runs: @runs }
