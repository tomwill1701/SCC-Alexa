.container
  .navbar.navbar-default.navbar-fixed-top
    .container
      .navbar-header
        %button.navbar-toggle{"data-target" => "#navbar-main", "data-toggle" => "collapse", :type => "button"}
          %span.icon-bar
          %span.icon-bar
          %span.icon-bar
        = link_to "SCC", root_path, class: "navbar-brand"
      %center
        #navbar-main.navbar-collapse.collapse
          %ul.nav.navbar-nav
            - if current_user
              %li
                = link_to "Status", home_index_path
              %li
                = link_to "Jobs", search_jobs_path(:group => "Job")
              %li
                = link_to "Reports", search_jobs_path(:group => "Report")
              %li
                = link_to "Runs", runs_path
              - if current_user.admin?
                %li.dropdown
                  %a.dropdown-toggle{"aria-expanded" => "false", "data-toggle" => "dropdown", :href => "#", :role => "button"}
                    Admin
                    %span.caret
                    %ul.dropdown-menu{:role => "menu"}
                      %li
                        = link_to "Setup", admin_root_path
                      %li
                        = link_to "Background jobs", "/delayed_job", target: "_blank"
              %li.dropdown
                %a.dropdown-toggle{"aria-expanded" => "false", "data-toggle" => "dropdown", :href => "#", :role => "button"}
                  = current_user.name.capitalize
                  %span.caret
                  %ul.dropdown-menu{:role => "menu"}
                    %li
                      = link_to 'Profile', edit_user_path(current_user)
                    %li
                      = link_to "Logoff", application_signout_path, method: :delete
            - else
              .form-group
              = bootstrap_form_tag url: application_signin_path, class: "navbar-form navbar-right", layout: :inline, method: "post" do |f|
                .form-group
                  = f.text_field :name, placeholder: "Name", hide_label: true, id: "username"
                  .form-group
                  = f.password_field :password, placeholder: "Password", hide_label: true, id: "pwd"
                  = f.submit "Login", id: "login"
