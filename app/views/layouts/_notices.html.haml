- if flash[:notice]
  .alert.alert-success= flash[:notice]
- if flash[:error]
  .alert.alert-danger.alert-dismissible
    %button.close{"aria-label" => "Close", "data-dismiss" => "alert", :type => "button"}
      %span{"aria-hidden" => "true"} &times;
    = flash[:error]
- if flash[:warning]
  .alert.alert-warning= flash[:warning]
