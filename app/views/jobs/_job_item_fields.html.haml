.nested-fields
  = f.inputs do
    = f.input :cgroup_id, as: :select, collection: Cgroup.all, input_html: {},
      label: "Command", member_label: :qual
    = f.input :lgroup_id, as: :select, collection: Lgroup.all, label: "LPAR",
        member_label: :qual
    = f.input :size
    = f.input :chart_title
    = f.input :chart_type, as: :select,
        collection: ["Pie", "Bar", "Line", "Gauge", "Area", "Candle", "Bubble",
          "Column", "Combo", "Scatter", "Spark"]
    = f.input :chart_x
    = f.input :chart_y
    = f.input :chart_opt
    = link_to_remove_association "remove item", f, class: "button"