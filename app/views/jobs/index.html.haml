.container
  .well
    %h1 Job Selection
    %hr/
    %h4 Search options
    = search_form_for @q do |f|
      .row
        .col-md-12
          .form-group.chardin_box
            = f.label :name
            = f.search_field :name_cont
            = f.label :description
            = f.search_field :description_cont
            = f.label :tag
            = f.search_field :tags_cont
          .form-group.chardin_box
            = f.label :class
            = f.select :cclass_eq, Job.order(:cclass).uniq.pluck(:cclass), include_blank: true
            = f.label :type
            = f.select :run_type_eq, Job.order(:run_type).uniq.pluck(:run_type), include_blank: true
            = f.label :favorite
            = f.check_box :with_favorite, {}, current_user.id
            = f.label :private
            = f.check_box :with_private, {}, current_user.id
          .form-group.chardin_box
            = f.submit class: 'btn btn-info btn-xs'
            = link_to 'Clear Filters', jobs_path, class: 'btn btn-default btn-xs'
  %br/
  %br/
  %ul.accordion-tabs
    %li.tab-header-and-content
      %a.tab-link.is-active{:href => "/jobs/search?tab=ALL"} All
      .tab-content{:data => { :url => "/jobs/search?tab=ALL&inline=true" }}
        = render partial: 'jobs/list', locals: { jobs: @jobs }
        .loading{style: 'display:none;'}
          = image_tag "spinner.gif"
          %p Loading
    - @tabs.each do |tab|
      %li.tab-header-and-content
        %a.tab-link{:href => "/jobs/search?tab=#{tab}"} #{tab.capitalize}
        .tab-content{:data => { :url => "/jobs/search?tab=#{tab}&inline=true" }}
          .loading
            = image_tag "spinner.gif"
            %p Loading
  .div.pull-left
    = link_to 'New Job', new_job_path, class: "btn btn-info"
