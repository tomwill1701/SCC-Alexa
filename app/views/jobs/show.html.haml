.container
  .well
    .div.pull-right
      = link_to 'Run', run_job_path(@job), class: "btn btn-success btn-xs"
      = link_to 'Options', "#modal", class: "btn btn-info btn-xs", "data-toggle": "modal"
      = link_to 'Clone', clone_job_path(@job), class: "btn btn-danger btn-xs"
      - if @job.owner?(current_user)
        = link_to 'Edit', edit_job_path(@job), class: "btn btn-default btn-xs"
        = link_to 'Delete', @job, method: :delete, class: "btn btn-primary btn-xs",
            data: { confirm: 'Are you sure?' }
    %br
    %h1 Job Details
    %hr
    = bootstrap_nested_form_for @job do |f|
      .row
        .col-md-3= f.text_field :name, disabled: 'true'
        .col-md-3= f.text_field :jtype, label: "Tab", disabled: 'true'
        .col-md-3= f.text_field :cclass, label: "Class", disabled: 'true'
        .col-md-3= f.text_field :run_type, disabled: 'true'
        .col-md-3= f.number_field :keep_days, as: :number, disabled: 'true'
        .col-md-3= f.text_field :tags, disabled: 'true'
        .col-md-1= f.check_box :private, disabled: 'true'
        .col-md-1= f.check_box :notify, as: :boolean, disabled: 'true'
        .col-md-1= f.check_box :cache, as: :boolean, disabled: 'true'
      .row
        .col-md-12= f.text_area :description, disabled: 'true', rows: '3'
      .row
        %h2 Command Groups
        %hr/
        = f.fields_for :job_items do | jobitem |
          = render 'show_item_fields', f: jobitem
        = link_to 'Close', jobs_path, class: 'btn btn-default pull-right'
= render 'runopts'
