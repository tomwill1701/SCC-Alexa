    <method name="beforeFactory"><![CDATA[importPackage(Packages.org.eclipse.birt.chart.model);
importPackage(Packages.org.eclipse.birt.chart.model.attribute);

c("Chart1");
c("Chart2");
c("Chart3");
c("Chart4");


function c(name) {

chart = reportContext.getDesignHandle().findElement(name);
item = chart.getReportItem();
cm = item.getProperty("chart.instance");

xAxis = cm.getAxes( ).get(  0  );
xSeriesDef = xAxis.getSeriesDefinitions( ).get( 0 );
xGrouping = xSeriesDef.getGrouping( );

var g = params["Group"].toUpperCase();
 
if (g.equals("DAYS")) {
  xGrouping.setGroupingUnit(GroupingUnitType.DAYS_LITERAL);
} else if (g.equals("WEEKS")) {
  xGrouping.setGroupingUnit(GroupingUnitType.WEEKS_LITERAL);
} else if (g.equals("MONTHS")) {
  xGrouping.setGroupingUnit(GroupingUnitType.MONTHS_LITERAL);
} else if (g.equals("YEARS")) {
  xGrouping.setGroupingUnit(GroupingUnitType.YEARS_LITERAL);
} else if (g.equals("HOURS")) {
  xGrouping.setGroupingUnit(GroupingUnitType.HOURS_LITERAL);
}

}
]]></method>
