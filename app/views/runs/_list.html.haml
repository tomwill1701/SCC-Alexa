%table.table
  %tr
    %th=sort_link @q, :name, "Jobname"
    %th=sort_link @q, :status, "Status"
    %th=sort_link @q, :error, "Error"
    %th=sort_link @q, :start, "Ran on"
    %th=sort_link @q, :viewed, "Last viewed"
    %th=sort_link @q, :delete_at, "Delete at"
  - runs.each do |run|
    %tr
      %td= link_to run.name, job_path(run.job), class: 'btn btn-default btn-xs'
      %td= run.status
      %td= run.error
      %td= run.start
      %td= run.viewed
      %td= run.delete_at.try(:strftime, '%b %d, %Y')
      %td= link_to 'Report', job_run_view_path(run)
      %td= link_to 'Details', run_path(run)
      %td= link_to 'Delete', run, method: :delete, class: 'btn btn-primary btn-xs'

.chardin_box{ :'data-position' => 'top' }
  = paginate runs
