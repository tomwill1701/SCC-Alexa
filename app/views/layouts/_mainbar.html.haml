%nav.navbar.navbar-default.navbar-fixed-top
  .container
    .navbar-header
      %button.navbar-toggle.collapsed{"aria-controls" => "navbar", "aria-expanded" => "false", "data-target" => "#navbar", "data-toggle" => "collapse", :type => "button"}
        %span.sr-only Toggle navigation
        %span.icon-bar
        %span.icon-bar
        %span.icon-bar
      %a.navbar-brand
        = link_to "SCC", root_path, class: "navbar-brand"
    #navbar.collapse.navbar-collapse
      %ul.nav.navbar-nav
        - if current_user
          %li= link_to "Home", home_index_path
          %li= link_to "Jobs", jobs_path
          %li= link_to "Runs", runs_path
          - if current_user.admin?
            %li.dropdown
              %a.dropdown-toggle{"aria-expanded" => "false", "data-toggle" => "dropdown", :href => "#", :role => "button"}
                Admin
                %span.caret
                %ul.dropdown-menu{:role => "menu"}
                  %li= link_to "Setup", admin_root_path
                  %li= link_to "Background jobs", "/delayed_job", target: "_blank"
          %li.dropdown
            %a.dropdown-toggle{"aria-expanded" => "false", "data-toggle" => "dropdown", :href => "#", :role => "button"}
              =current_user.name
              %span.caret
              %ul.dropdown-menu{:role => "menu"}
                %li= link_to 'Profile', edit_user_path(current_user)
                %li= link_to "Logoff", application_signout_path, method: :delete
        - else
          .navbar-pull-right
          = bootstrap_form_tag url: application_signin_path, layout: :inline, method: "post" do |f|
            .form-group
              = f.text_field :name, placeholder: "Name", hide_label: true, id: "username"
              .form-group
              = f.password_field :password, placeholder: "Password", hide_label: true, id: "pwd"
              = f.submit "Login", id: "login"