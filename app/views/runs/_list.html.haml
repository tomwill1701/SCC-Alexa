%table.table
  %tr
    %th=sort_link @q, :name, "Jobname"
    %th=sort_link @q, :status, "Status"
    %th=sort_link @q, :done, "Done"
    %th=sort_link @q, :error, "Error"
    %th=sort_link @q, :start, "Run date"
    %th=sort_link @q, :delete_at, "Delete date"
  - runs.each do |run|
    %tr
      %td= run.name
      %td= run.status
      %td= run.done
      %td= run.error
      %td= run.start
      %td= run.delete_at
      %td= link_to 'View', job_run_view_path(run)
      %td= link_to 'Show', run_path(run)
      %td= link_to 'Delete', run, method: :delete

.chardin_box{ :'data-position' => 'top' }
  = paginate runs