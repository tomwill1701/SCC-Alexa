<div class="container">
  <div class="navbar navbar-default navbar-fixed-top">
    <div class="container">
      <div class="navbar-header">
        <button class="navbar-toggle" type="button" data-toggle="collapse" data-target="#navbar-main">
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        </button>
        <%= link_to "SCC", root_path, class: "navbar-brand" %>
      </div>
      <center>
      <div class="navbar-collapse collapse" id="navbar-main">
        <ul class="nav navbar-nav">
          <% if current_user %>
          <li>
            <%= link_to "Status", home_index_path %>
          </li>
          <li>
            <%= link_to "Jobs", jobs_path %>
          </li>
          <li>
            <%= link_to "Runs", runs_path %>
          </li>
          <% if current_user.admin? %>
          <li class="dropdown">
            <a aria-expanded="false" class="dropdown-toggle" data-toggle="dropdown" href="#" role="button">
              Admin
              <span class="caret"></span>
              <ul class="dropdown-menu" role="menu">
                <li>
                  <%= link_to "Setup", admin_root_path %>
                </li>
                <li>
                  <%= link_to "Background jobs", "/delayed_job", target: "_blank" %>
                </li>
              </ul>
            </a>
          </li>
          <% end %>
          <li class="dropdown">
            <a aria-expanded="false" class="dropdown-toggle" data-toggle="dropdown" href="#" role="button">
              <%= current_user.name %>
              <span class="caret"></span>
              <ul class="dropdown-menu" role="menu">
                <li>
                  <%= link_to 'Profile', edit_user_path(current_user) %>
                </li>
                <li>
                  <%= link_to "Logoff", application_signout_path, method: :delete %>
                </li>
              </ul>
            </a>
          </li>
          <% else %>
          <div class="form-group"></div>
          <%= bootstrap_form_tag url: application_signin_path, class: "navbar-form navbar-right", layout: :inline, method: "post" do |f| %>
          <div class="form-group">
            <%= f.text_field :name, placeholder: "Name", hide_label: true, id: "username" %>
            <div class="form-group"></div>
            <%= f.password_field :password, placeholder: "Password", hide_label: true, id: "pwd" %>
            <%= f.submit "Login", id: "login" %>
          </div>
          <% end %>
          <% end %>
        </div>
        </center>
    </div>
  </div>
</div>