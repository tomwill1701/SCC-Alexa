.modal.fade#modal
  .modal-dialog
    .modal-content
      .modal-header
        %button.close{"aria-label" => "Close", "data-dismiss" => "modal", :type => "button"}
          %span{"aria-hidden" => "true"}
        %h4.modal-title Enter Run Options
      .modal-body
        = bootstrap_form_tag url: run_job_path(@job), method: :get do |f|
          = f.collection_select :ugroup_id, current_user.ugroups, :id, :name,
            label: "Group"
          = f.check_box :cache, checked: true
          = f.check_box :background, checked: true
          = f.check_box :notify, checked: true
          = f.check_box :debug, checked: false
          .row
            .col-md-4
              = f.number_field :keep_days, hide_label: true, append: "days",
                class: "input-sm", placeholder: "keep run"
          .modal-footer
            = f.submit "Run", class: "btn btn-success"
            %button.btn.btn-default{"data-dismiss" => "modal", :type => "button"} Close
