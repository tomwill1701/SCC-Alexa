<div class="container">
  <div class="well">
    <h1>Job Selection</h1>
    <hr>
    <h4>Search options</h4>
    <%= search_form_for @q do |f| %>
    <div class="row">
      <div class="col-md-12">
        <div class="form-group chardin_box">
          <%= f.label :name %>
          <%= f.search_field :name_cont %>
          <%= f.label :description %>
          <%= f.search_field :description_cont %>
          <%= f.label :tag %>
          <%= f.search_field :tags_cont %>
        </div>
        <div class="form-group chardin_box">
          <%= f.label :class %>
          <%= f.select :cclass_eq, Job.order(:cclass).uniq.pluck(:cclass), include_blank: true %>
          <%= f.label :type %>
          <%= f.select :run_type_eq, Job.order(:run_type).uniq.pluck(:run_type), include_blank: true %>
          <%= f.label :favorite %>
          <%= f.check_box :with_favorite, {}, current_user.id %>
          <%= f.label :private %>
          <%= f.check_box :with_private, {}, current_user.id %>
        </div>
        <div class="form-group chardin_box">
          <%= f.submit %>
          <%= link_to 'Clear Filters', jobs_path %>
        </div>
      </div>
    </div>
    <% end %>
  </div>
  <div class="div pull-right">
    <%= link_to 'New Job', new_job_path, class: "btn btn-primary" %>
  </div>
  <br/>
  <br/>
  <% if @tabs %>
  <ul class="nav nav-tabs" id="tabs" role="tablist">
    <li class="active" role="presentation">
      <%= link_to "All", search_jobs_path(tab: "ALL"), {"aria-controls" => "home", :role => "tab"} %>
    </li>
    <% @tabs.each do |tab| %>
    <li role="presentation">
      <%= link_to tab, search_jobs_path(tab: tab), {"aria-controls" => "home", :role => "tab"} %>
    </li>
    <% end %>
  </ul>
  <% end %>
  <div id="results">
    <%= render partial: 'jobs/list', locals: { jobs: @jobs } %>
  </div>