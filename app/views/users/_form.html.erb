<div class="container">
<%= semantic_form_for @user do |f| %>
  <%= f.inputs do %>
    <%= f.input :name %>
    <%= f.input :password %>
    <%= f.input :department %>
    <%= f.input :phone %>
    <%= f.input :email %>
  <% end %>
  <br>
  <%= f.inputs do %>
    <%= f.input :ugroup, as: :select, collection: current_user.ugroups, label: "Default Group" %>
    <%= f.input :background,  as: :select, collection: ["Never", "Always"] %>
    <%= f.input :notify, as: :select, collection: ["Never", "Always"] %>
    <%= f.input :cache, as: :select, collection: ["Never", "Always"] %>
  <% end %>
  <br>
  <%= f.inputs do %>
    <%= f.input :racf_userid, label: "RACF Userid" %>
    <%= f.input :racf_group, label: "RACF Group" %>
    <%= f.input :racf_password, label: "RACF Password" %>
    <%= f.input :lpar, label: "LPAR" %>
  <% end %>
  <br>
  <%= f.submit "Update" %>
  <%= f.submit "Cancel" %>
<% end %>
</div>