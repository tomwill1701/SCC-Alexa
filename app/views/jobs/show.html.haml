.container
  .well
    %h1 Job Details
    %hr
    .div.pull-right
      = link_to 'Run', run_job_path(@job), class: "button add-spinner"
      = link_to 'Run/options', "#modal", class: "button", "data-toggle": "modal"
      = link_to 'Clone', clone_job_path(@job), class: "button"
      - if @job.owner?(current_user)
        = link_to 'Edit', edit_job_path(@job), class: "button"
        = link_to 'Delete', @job, method: :delete, class: "button",
            data: { confirm: 'Are you sure?' }
    %br
    %br
    = bootstrap_form_for @job do |f|
      .row
        .col-md-3= f.text_field :name, disabled: 'true'
        .col-md-3= f.text_field :jtype, label: "Tab", disabled: 'true'
        .col-md-3= f.text_field :cclass, label: "Class", disabled: 'true'
        .col-md-3= f.text_field :run_type, disabled: 'true'
        .col-md-3= f.number_field :keep_days, as: :number, disabled: 'true'
        .col-md-3= f.text_field :tags, disabled: 'true'
        .col-md-1= f.check_box :private, disabled: 'true'
        .col-md-1= f.check_box :notify, as: :boolean, disabled: 'true'
        .col-md-1= f.check_box :cache, as: :boolean, disabled: 'true'
      .row
        .col-md-12= f.text_area :description, disabled: 'true', rows: '4'
      .row  
        = form_for :job_items do | jobitem |
          = render 'show_item_fields', f: jobitem
    = link_to 'Close', jobs_path, class: 'btn btn-default'
= render 'runopts'