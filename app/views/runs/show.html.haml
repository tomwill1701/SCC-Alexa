.container
  %dl.dl-horizontal
    %dt Job:
    %dd #{@job.name}
    %dt Status
    %dd #{@run.dstatus}
    %dt Owner:
    %dd #{@run.user.name}
    %dt Log:
    %dd #{@run.log}
    %br Commands:
  - @rc.each do |rc|
    - if rc.lpar
      %br #{rc.lpar.name}
    = rc.source
    = rc.model
    .code.scroll #{rc.rtext.gsub("\r",'<br>').html_safe}
  = link_to 'Edit', root_path