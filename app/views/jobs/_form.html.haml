%h4
= semantic_form_for @job do |f|
  = f.inputs do
    = f.input :name
    = f.input :cclass, label: "Class"
    = f.input :run_type, as: :select, collection: ["Real-Time", "Background", "External"]
    = f.input :private, as: :boolean
    = f.input :notify, as: :boolean
    = f.input :cache, as: :boolean
    = f.input :keep_days, as: :number
    = f.input :tags
  = f.inputs do
    = f.input :description, input_html: {:class => 'autogrow', :rows => 3}
    = f.hidden_field :owner_id, value: @job.owner_id
  = f.inputs "Command Group" do
    = f.semantic_fields_for :job_items do | jobitem |
      = render 'job_item_fields', f: jobitem
    .links
      = link_to_add_association 'add item', f, :job_items, class: "button"
  = f.actions do
    = f.action :submit, as: :button
    = f.action :cancel