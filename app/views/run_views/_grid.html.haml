Grid #{rv.command.name}
%br
%input{:onclick => "grid.toPDF('http://dhtmlxgrid.appspot.com/export/pdf');",
  :type => "linkx", :value => "Export to PDF"}/
.grid{:id => "grid#{rv.id}", :style => "width: #{rv.size[0]}; height: #{rv.size[1]};"}
%script{:charset => "UTF-8", :type => "text/javascript"}
  var grid = new dhtmlXGridObject("grid#{rv.id}");
  grid.setImagePath("assets/imgs/");
  grid.setHeader('#{rv.columnNames.html_safe}');
  grid.setColSorting('#{rv.columnSorting.html_safe}');
  grid.setColAlign('#{rv.columnAlign.html_safe}');
  grid.attachHeader("#select_filter");
  grid.setSkin("dhx_skyblue");
  grid.enableAutoWidth(true);
  grid.enableAutoHeight(true);
  grid.enableMultiselect(true);
  grid.setSizes();
  grid.init();
  grid.parse('#{rv.rows.to_json.html_safe}', "jsarray");