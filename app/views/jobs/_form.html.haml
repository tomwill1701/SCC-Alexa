= bootstrap_nested_form_for @job do |f|
  .row
    .col-md-3= f.text_field :name
    .col-md-2= f.select :jgroup, %w{Job Report}, { label: "Group" }, { class: "selectpicker" }
    .col-md-2= f.text_field :jtype, label: "Tab"
    .col-md-2= f.text_field :cclass, label: "Class"
    .col-md-2= f.select :run_type, %w{Real-Time Background External}, { label: "Run Type" }, { class: "selectpicker" }
  .row
    .col-md-2= f.number_field :keep_days, as: :number
    .col-md-3= f.text_field :tags
    .col-md-1= f.check_box :private, as: :boolean
    .col-md-1= f.check_box :notify, as: :boolean
    .col-md-1= f.check_box :cache, as: :boolean
  .row
    .col-md-3= f.text_field :alert_types
    .col-md-3= f.text_field :alert_message
  .row
    .col-md-2= f.select :ar_type, %w{Minute Hour Day Month Once}, { label: "Auto Run", include_blank: true },
        { class: "selectpicker" }
    .col-md-2= f.text_field :ar_start_date, label: "Start Date", class: 'datepicker'
    .col-md-2= f.time_field :ar_start_time, label: "Start Time"
    .col-md-3= f.text_field :ar_hour, label: "Hours (0-23)"
    .col-md-3= f.text_field :ar_file, label: "Filename"
  .row
    .col-md-3= f.text_field :ar_day, label: "Days (1-31)"
    .col-md-3= f.text_field :ar_wday, label: "Week Days (M-S)"
    .col-md-3= f.text_field :ar_month, label: "Months (1-12)"
    .col-md-3= f.text_field :ar_wdayt, label: "Week Numbers (1-4)"
  .row
    .col-md-12= f.text_area :description, rows: '4'
    = f.hidden_field :owner_id, value: @job.owner_id
  .row
    .col-md-12
      %h2 Command Groups
      %hr
  .row
    = f.fields_for :job_items do | jobitem |
      = render 'job_item_fields', f: jobitem
  .row
    %br/
    .col-md-3= link_to_add_association 'add item', f, :job_items, class: "btn btn-success btn-xs pull-left"
    %br
    %br
    %br
  :javascript
    $('.datepicker').datepicker({format: 'yyyy-mm-dd'});
  = f.submit :Submit, class: "btn btn-info"
  = link_to 'Cancel', jobs_path, class: 'btn btn-default'

<script>
$('.datepicker').datepicker({format: 'yyyy-mm-dd'});
</script>
