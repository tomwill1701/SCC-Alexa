%table.table
  %tr
    %th=link_to 'Del', {}, {href:'#', class: "batch_action", data_action: "delete"}
    %th=sort_link @q, :name, "Jobname"
    %th=sort_link @q, :status, "Status"
    %th=sort_link @q, :status, "Group"
    %th=sort_link @q, :error, "Error"
    %th=sort_link @q, :start, "Ran on"
    %th=sort_link @q, :viewed, "Last viewed"
    %th=sort_link @q, :delete_at, "Delete at"
  - runs.each do |run|
    %tr
      %td
        = check_box_tag 'select[]', run.id
      %td= link_to run.name, job_path(run.job)
      %td= run.status
      %td= run.ugroup.name
      %td= run.error
      %td= run.start
      %td= run.viewed
      %td= run.delete_at.try(:strftime, '%b %d, %Y')
      %td.dropdown
        %a.dropdown-toggle{"aria-expanded" => "false", "data-toggle" => "dropdown", :href => "#", :role => "button"}
          View
          %span.caret
        %ul.dropdown-menu
          %li= link_to 'Report', job_run_view_path(run)
          %li= link_to 'Details', run_path(run)
      %td= link_to 'Delete', run, method: :delete

.chardin_box{ :'data-position' => 'top' }
  = paginate runs