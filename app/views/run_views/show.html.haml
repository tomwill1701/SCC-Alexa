.container
  .well
    .row
      .col-md-8
        %h4
          Run view for Job
          = link_to @run.name, job_path(@run.job), class: "btn btn-default btn-xs"
          at #{@run.start}
      .col-md-4
        .pull-right
          = link_to 'Details', run_path(@run), class: "btn btn-info btn-xs"
          = link_to 'Rerun', run_path(@run), class: "btn btn-success btn-xs"
          = link_to 'Delete', @run, method: :delete, class: "btn btn-primary btn-xs", data: { confirm: 'Are you sure?' }
    - @rv.each do |rv|
      - if !rv.hide
        - rv.attr
        - if rv.vtype == 'chart'
          = render :partial => 'run_views/chart', locals: { rv: rv }
        - elsif rv.vtype == "grid"
          = render :partial => 'run_views/grid', locals: { rv: rv }
        - elsif rv.vtype == 'text'
          = render :partial => 'run_views/text', locals: { rv: rv }
        - elsif rv.vtype == 'file'
          = render :partial => 'run_views/file', locals: { rv: rv }
        %br
        %br
