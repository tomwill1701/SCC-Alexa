.page-header
  %h3.chardin_box{ "data-position": :right }
    Runs Selection
.well
  %h4 Search options
  = search_form_for @q do |f|
    .row
      .col-md-12
        .form-group.chardin_box
          .col-md-4
            = f.label "Run on"
            = f.text_field :start_gteq, class: 'datepicker'
          .col-md-4
            = f.label "Delete on"
            = f.text_field :delete_at_gteq, class: 'datepicker'
          .col-md-4
            = f.label "Viewed on"
            = f.text_field :viewed_gteq, class: 'datepicker'
        .form-group.chardin_box
          = f.label :status
          = f.select :status_eq, Run.order(:status).uniq.pluck(:status), include_blank: true
          = f.label :error
          = f.check_box :with_error
          = f.label :done
          = f.check_box :with_done
          = f.label :never_viewed
          = f.check_box :with_nv
        .form-group.chardin_box
          = f.submit
          = link_to 'Clear Filters', runs_path
#results
  = render :partial => 'runs/list', locals: { runs: @runs }
