%table.table
  %tr
    %th= sort_link @q, :name, 'Name'
    %th= sort_link @q, :cclass, 'Class'
    %th= sort_link @q, :run_type, 'Run Type'
    %th= sort_link @q, :updated_at, 'Last Changed'
  - jobs.each do |job|
    %tr
      %td= link_to job.name, job, {"data-toggle" => "tooltip", title: job.description}
      %td= job.cclass
      %td= job.run_type
      %td= job.updated_at
      %td= link_to 'Run', run_job_path(job)
      - if job.favorite_job?(current_user)
        %td= link_to 'Unfav', unfavorite_job_path(job), method: :delete
      -else
        %td= link_to 'Fav', favorite_job_path(job), method: :post
      - if job.owner?(current_user)
        %td= link_to 'Edit', edit_job_path(job)
        %td= link_to 'Delete', job, method: :delete, data: { confirm: 'Are you sure?' } 

.chardin_box{ :'data-position' => 'top' }
  = paginate jobs
