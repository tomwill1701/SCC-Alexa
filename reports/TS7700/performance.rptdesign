            <list-property name="computedColumns">
                <structure>
                    <property name="name">cb_r</property>
                    <expression name="expression">(row["P0_CHAN_BYTES_R"]+row["P1_CHAN_BYTES_R"])/row["INT_DURATION"]</expression>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="name">cb_w</property>
                    <expression name="expression">(row["P0_CHAN_BYTES_W"]+row["P1_CHAN_BYTES_W"])/row["INT_DURATION"]</expression>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="name">vb_r</property>
                    <expression name="expression">(row["P0_VIRT_BYTES_R"]+row["P1_VIRT_BYTES_R"])/row["INT_DURATION"]</expression>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="name">vb_w</property>
                    <expression name="expression">(row["P0_VIRT_BYTES_W"]+row["P1_VIRT_BYTES_W"])/row["INT_DURATION"]</expression>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="name">comp</property>
                    <expression name="expression">BirtMath.safeDivide(row["cb_r"]+row["cb_w"],row["vb_r"]+row["vb_w"],0)</expression>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
